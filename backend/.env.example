# Copia este fichero a .env y rellena los valores reales. .env nunca se commitea.

NODE_ENV=development
PORT=3000

# Neon (PostgreSQL, región EU/Frankfurt) — connection string del proyecto.
DATABASE_URL="postgresql://user:password@host/db?schema=public"

# Secreto para firmar el access token JWT del gestor. Generar uno fuerte:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PASSWORD_RESET_TOKEN_TTL_MIN=60

THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_SECONDS=900

# Origen exacto del backoffice (CORS con credentials:true, nunca '*').
CORS_ORIGIN="http://localhost:5000"

# URL pública usada en los enlaces enviados por email. Si se omite, se usa
# el primer origen de CORS_ORIGIN.
BACKOFFICE_PUBLIC_URL="http://localhost:5000"

# Cloudflare R2 (object storage S3-compatible, jurisdicción UE).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=

# Reservadas para features futuras (alertas AEMET, push FCM) — no usadas en esta slice.
AEMET_API_KEY=
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
